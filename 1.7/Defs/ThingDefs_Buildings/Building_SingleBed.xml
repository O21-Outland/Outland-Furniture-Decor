<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="OutlandArtableBedBase">
		<defName>Outland_RusticBedSingle</defName>
		<label>rustic bed</label>
		<description>A cozy mattress and sheets on a frame for resting.</description>
		<techLevel>Medieval</techLevel>
		<graphicData>
			<texPath>Outland/Buildings/Furniture/SingleBed</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<size>(1,2)</size>
		<uiIconScale>0.90</uiIconScale>
		<fillPercent>0.4</fillPercent>
		<pathCost>60</pathCost>
		<staticSunShadowHeight>0.15</staticSunShadowHeight>
		<castEdgeShadows>True</castEdgeShadows>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Beauty>8</Beauty>
			<WorkToBuild>800</WorkToBuild>
			<Mass>45</Mass>
			<BedRestEffectiveness>1</BedRestEffectiveness>
			<Comfort>0.75</Comfort>
