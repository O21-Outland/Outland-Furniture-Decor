		<building>
			<bed_showSleeperBody>False</bed_showSleeperBody>
			<bed_healPerDay>5</bed_healPerDay>
			<paintable>true</paintable>
		</building>
		<costStuffCount>45</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Furniture</li>
				</subcategories>
			</li>
		</modExtensions>
