<?xml version="1.0" encoding="UTF-8"?>
<Defs>
	
	<ThingDef ParentName="OutlandArtableFurnitureBase">
		<defName>Outland_Bench</defName>
		<label>rustic bench</label>
		<description>A wide wooden bench.</description>
		<graphicData>
			<texPath>Outland/Buildings/Furniture/Bench</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<shaderType>Cutout</shaderType>
			<drawSize>(4, 4)</drawSize>
            <drawOffset>(0.0, 0.0, 0.05)</drawOffset>
		</graphicData>
		<size>(2,1)</size>
		<altitudeLayer>BuildingBelowTop</altitudeLayer>
		<socialPropernessMatters>true</socialPropernessMatters>
		<fillPercent>0.45</fillPercent>
		<defaultPlacingRot>South</defaultPlacingRot>
		<pathCost>30</pathCost>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToBuild>12000</WorkToBuild>
			<Mass>8</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>8</Beauty>
			<Comfort>0.75</Comfort>
		</statBases>
		<building>
			<isSittable>true</isSittable>
			<paintable>true</paintable>
		</building>
		<costStuffCount>85</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Furniture</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>
    
</Defs>