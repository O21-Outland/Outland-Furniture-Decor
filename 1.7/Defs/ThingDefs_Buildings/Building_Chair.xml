<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="OutlandArtableFurnitureBase">
		<defName>Outland_Chair</defName>
		<label>rustic chair</label>
		<description>A comfortable chair. Can be used at tables, work stations, and elsewhere.</description>
		<graphicData>
			<texPath>Outland/Buildings/Furniture/Chair</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<drawSize>(2.5,2.5)</drawSize>
		</graphicData>
		<uiIconScale>0.6</uiIconScale>
		<uiIconOffset>(0, 0)</uiIconOffset>
		<altitudeLayer>Building</altitudeLayer>
		<socialPropernessMatters>true</socialPropernessMatters>
		<fillPercent>0.35</fillPercent>
		<defaultPlacingRot>South</defaultPlacingRot>
		<pathCost>30</pathCost>
		<statBases>
			<MaxHitPoints>130</MaxHitPoints>
			<WorkToBuild>5000</WorkToBuild>
			<Mass>4</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<Comfort>0.65</Comfort>
		</statBases>
		<building>
			<isSittable>true</isSittable>
			<paintable>true</paintable>
		</building>
		<costStuffCount>45</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Furniture</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>
    
</Defs>