<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<DesignatorDropdownGroupDef>
		<defName>Outland_WallSconce</defName>
		<label>rustic wall sconces</label>
	</DesignatorDropdownGroupDef>

	<ThingDef ParentName="OutlandWallLightBase" Name="OutlandWallSconceBase" Abstract="True">
		<description>A wall mounted lighting fixture. Embedded into the wall slightly.</description>
		<graphicData>
			<texPath>Outland/Buildings/Furniture/WallLampFlush</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
			<drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
			<drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
			<drawOffsetEast>(0.9,0,0)</drawOffsetEast>
			<damageData>
			  <enabled>false</enabled>
			</damageData>
		</graphicData>
		<uiIconPath>Outland/Buildings/Furniture/WallLampFlush_north</uiIconPath>
		<statBases>
			<MaxHitPoints>10</MaxHitPoints>
			<WorkToBuild>100</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Mass>2</Mass>
		</statBases>
		<costStuffCount>5</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>2.0</fuelConsumptionRate>
				<fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
				<fuelCapacity>20.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>WoodLog</li>
						<li>Chemfuel</li>
					</thingDefs>
				</fuelFilter>
				<initialFuelPercent>1</initialFuelPercent>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>3.5</heatPerSecond>
				<heatPushMaxTemperature>23</heatPushMaxTemperature>
			</li>
			<li Class="CompProperties_MeditationFocus">
				<statDef>MeditationFocusStrength</statDef>
				<focusTypes>
					<li>Flame</li>
				</focusTypes>
				<offsets>
					<li Class="FocusStrengthOffset_Lit">
						<offset>0.1</offset>
					</li>
				</offsets>
			</li>
		</comps>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Furniture</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="OutlandWallSconceBase">
		<defName>Outland_RusticWallSconce</defName>
		<label>rustic sconce</label>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>9</glowRadius>
				<glowColor>(184, 136, 83, 0)</glowColor>
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="OutlandWallSconceBase" MayRequire="Ludeon.RimWorld.Ideology">
		<defName>Outland_RusticWallSconce_Darklight</defName>
		<label>rustic sconce (darklight)</label>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>9</glowRadius>
				<glowColor>(78, 226, 229, 0)</glowColor>
			</li>
		</comps>
	</ThingDef>
    
</Defs>