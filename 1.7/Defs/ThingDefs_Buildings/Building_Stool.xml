<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="OutlandFurnitureWithQualityBase">
		<defName>Outland_RusticStool</defName>
		<label>rustic stool</label>
		<description>A simple platform on which to sit. Not very comfortable, but much better than nothing. Can be used at tables, work stations, and elsewhere.</description>
		<graphicData>
			<texPath>Outland/Buildings/Furniture/Stool</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<drawSize>(2.5,2.5)</drawSize>
		</graphicData>
		<pathCost>30</pathCost>
		<fillPercent>0.20</fillPercent>
		<uiIconOffset>(0, -0.05)</uiIconOffset>
		<rotatable>false</rotatable>
		<altitudeLayer>Building</altitudeLayer>
		<socialPropernessMatters>true</socialPropernessMatters>
		<statBases>
			<MaxHitPoints>85</MaxHitPoints>
			<WorkToBuild>560</WorkToBuild>
			<Mass>3</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<Comfort>0.6</Comfort>
		</statBases>
		<building>
			<isSittable>true</isSittable>
			<paintable>true</paintable>
		</building>
		<costStuffCount>25</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Furniture</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>
    
</Defs>